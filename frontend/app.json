{
  "expo": {
    "name": "GymBuddy",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gymbuddy",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.fitjourneyapp.hny3xq",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan food barcodes to log nutrition",
        "NSPhotoLibraryUsageDescription": "Set your profile and progress photos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F1113"
      },
      "package": "com.emergent.fitjourneyapp.hny3xq",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F1113"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Scan food barcodes to log nutrition"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Set your profile and progress photos"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ecc32c1c-7ed5-4893-9417-a18915f7af25"
      }
    },
    "owner": "gymbuddy22"
  }
}
